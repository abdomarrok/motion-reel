{
  "name": "motion-reel",
  "version": "1.0.0",
  "description": "Motion Reel Studio — TikTok motion graphic video generator",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite app --port 5173",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build app",
    "preview": "vite preview app",
    "render:cli": "node scripts/render.mjs"
  },
  "keywords": [
    "motion-graphics",
    "video-generator",
    "tiktok",
    "reels",
    "motion-design",
    "canvas",
    "playwright",
    "ffmpeg"
  ],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "playwright": "^1.64.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0"
  }
}
